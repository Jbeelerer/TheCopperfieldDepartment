{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "04c3d4fb8eb14e05a84af1676ee1bcfc",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "AspectFitUV_float (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -340.5,
            "y": 17.5,
            "width": 255.5,
            "height": 101.00000762939453
        }
    },
    "m_Slots": [
        {
            "m_Id": "c73a5405256a4e7298f75e26f21881f3"
        },
        {
            "m_Id": "21900e6c546f4688b334ea61ba204717"
        },
        {
            "m_Id": "0198ae9c8f52435db6b8a2768b32a6fe"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "AspectFitUV_float",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "void AspectFitUV_float(float2 UV, float2 TexSize, float2 QuadSize, out float2 FittedUV, out float Mask)\n{\n    float texAspect = TexSize.x / TexSize.y;\n    float quadAspect = QuadSize.x / QuadSize.y;\n\n    float2 scale = float2(1, 1);\n    if (texAspect > quadAspect)\n        scale.y = quadAspect / texAspect;\n    else\n        scale.x = texAspect / quadAspect;\n\n    FittedUV = (UV - 0.5) / scale + 0.5;\n\n    // 1 inside the valid image area, 0 in the letterbox/pillarbox margin\n    Mask = (FittedUV.x >= 0 && FittedUV.x <= 1 && FittedUV.y >= 0 && FittedUV.y <= 1) ? 1 : 0;\n}"
}

